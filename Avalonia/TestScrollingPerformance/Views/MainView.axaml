<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TestScrollingPerformance.Views.MainView"
             Foreground="#FF2B2F36">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Background="#FFFAF8F5">
            <StackPanel>
                <!-- Masthead -->
                <Border Background="#FF14171C" Padding="20,14">
                    <Grid MaxWidth="1100">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="34" Height="34">
                                <Ellipse>
                                    <Ellipse.Fill><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#FFE63946" Offset="0"/><GradientStop Color="#FFF4A261" Offset="1"/></LinearGradientBrush></Ellipse.Fill>
                                </Ellipse>
                                <Path Data="M12,9 L12,24 L23,24" Stroke="White" StrokeThickness="3.5" StrokeLineCap="Round" StrokeJoin="Round"/>
                            </Grid>
                            <TextBlock Text="LOREM" Foreground="White" FontSize="21" FontWeight="Black" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="magazine" Foreground="#FFF4A261" FontSize="21" FontStyle="Italic" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M19,11 A8,8 0 1 1 3,11 A8,8 0 1 1 19,11 Z M21,21 L16.65,16.65" Width="20" Height="20" Stretch="Uniform" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Margin="0,0,18,0"/>
                            <Path Data="M19,21 L12,16 L5,21 L5,5 A2,2 0 0 1 7,3 L17,3 A2,2 0 0 1 19,5 Z" Width="20" Height="20" Stretch="Uniform" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Margin="0,0,18,0"/>
                            <Path Data="M3,12 L21,12 M3,6 L21,6 M3,18 L21,18" Width="22" Height="22" Stretch="Uniform" Stroke="White" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="#FF1F242C" Padding="12,0">
                    <Grid MaxWidth="760">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,12,0,0">
                            <TextBlock Text="IPSUM" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                            <Border Width="22" Height="3" CornerRadius="1.5" Margin="0,9,0,0" HorizontalAlignment="Center">
                                <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#FFE63946" Offset="0"/><GradientStop Color="#FFF4A261" Offset="1"/></LinearGradientBrush></Border.Background>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,12,0,0">
                            <TextBlock Text="DOLOR" FontSize="12" FontWeight="SemiBold" Foreground="#FFA9B1BB" HorizontalAlignment="Center"/>
                            <Border Width="22" Height="3" CornerRadius="1.5" Margin="0,9,0,0" HorizontalAlignment="Center">
                                <Border.Background><SolidColorBrush Color="Transparent"/></Border.Background>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,12,0,0">
                            <TextBlock Text="SIT" FontSize="12" FontWeight="SemiBold" Foreground="#FFA9B1BB" HorizontalAlignment="Center"/>
                            <Border Width="22" Height="3" CornerRadius="1.5" Margin="0,9,0,0" HorizontalAlignment="Center">
                                <Border.Background><SolidColorBrush Color="Transparent"/></Border.Background>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,12,0,0">
                            <TextBlock Text="AMET" FontSize="12" FontWeight="SemiBold" Foreground="#FFA9B1BB" HorizontalAlignment="Center"/>
                            <Border Width="22" Height="3" CornerRadius="1.5" Margin="0,9,0,0" HorizontalAlignment="Center">
                                <Border.Background><SolidColorBrush Color="Transparent"/></Border.Background>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,12,0,0">
                            <TextBlock Text="ELIT" FontSize="12" FontWeight="SemiBold" Foreground="#FFA9B1BB" HorizontalAlignment="Center"/>
                            <Border Width="22" Height="3" CornerRadius="1.5" Margin="0,9,0,0" HorizontalAlignment="Center">
                                <Border.Background><SolidColorBrush Color="Transparent"/></Border.Background>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel MaxWidth="760" Margin="20,28,20,0">
                    <!-- Article header -->
                    <TextBlock FontSize="13" Foreground="#FF6B7280" TextWrapping="Wrap">Home › Ipsum › <Run Foreground="#FFE63946">Dolor sit amet</Run></TextBlock>
                    <Border HorizontalAlignment="Left" CornerRadius="14" Padding="12,5" Margin="0,18,0,0">
                        <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#FFE63946" Offset="0"/><GradientStop Color="#FFF4A261" Offset="1"/></LinearGradientBrush></Border.Background>
                        <TextBlock Text="LOREM TRAVEL" FontSize="11" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Lorem Ipsum Dolor Sit Amet: Consectetur Adipiscing Elit Across the Northern Fjords" FontSize="38" FontWeight="Bold" LineHeight="46" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#FF111418"/>
                    <TextBlock Text="Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip." FontSize="19" LineHeight="29" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#FF5B6470"/>
                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Ellipse Width="52" Height="52" Stroke="White" StrokeThickness="2">
                            <Ellipse.Fill><ImageBrush Source="/Assets/Images/author.jpg" Stretch="UniformToFill"/></Ellipse.Fill>
                        </Ellipse>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="15" Foreground="#FF111418" TextWrapping="Wrap"><Bold>Lorema Ipsumova</Bold> · <Run Foreground="#FFE63946" FontWeight="SemiBold">Follow</Run></TextBlock>
                            <TextBlock Text="Senior Dolor Correspondent, Lorem Magazine" FontSize="13" Foreground="#FF6B7280" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <Border BorderBrush="#FFE5E1DA" BorderThickness="0,1,0,1" Padding="0,10" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 Z M12,6 L12,12 L16,14" Width="16" Height="16" Stretch="Uniform" Stroke="#FF6B7280" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                                <TextBlock Text="Nov 18, 2026 · 12 min read" FontSize="13" Foreground="#FF6B7280" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="160"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="#FFF0ECE6" Margin="8,0,0,0">
                                    <Path Data="M20.84,4.61 A5.5,5.5 0 0 0 13.06,4.61 L12,5.67 L10.94,4.61 A5.5,5.5 0 0 0 3.16,12.39 L4.22,13.45 L12,21.23 L19.78,13.45 L20.84,12.39 A5.5,5.5 0 0 0 20.84,4.61 Z" Width="16" Height="16" Stretch="Uniform" Stroke="#FF111418" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#FFF0ECE6" Margin="8,0,0,0">
                                    <Path Data="M19,21 L12,16 L5,21 L5,5 A2,2 0 0 1 7,3 L17,3 A2,2 0 0 1 19,5 Z" Width="16" Height="16" Stretch="Uniform" Stroke="#FF111418" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#FFF0ECE6" Margin="8,0,0,0">
                                    <Path Data="M21,5 A3,3 0 1 1 15,5 A3,3 0 1 1 21,5 Z M9,12 A3,3 0 1 1 3,12 A3,3 0 1 1 9,12 Z M21,19 A3,3 0 1 1 15,19 A3,3 0 1 1 21,19 Z M8.59,13.51 L15.42,17.49 M15.41,6.51 L8.59,10.49" Width="16" Height="16" Stretch="Uniform" Stroke="#FF111418" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Width="34" Height="34" CornerRadius="17" Background="#FFF0ECE6" Margin="8,0,0,0">
                                    <Path Data="M22,2 L11,13 M22,2 L15,22 L11,13 L2,9 Z" Width="16" Height="16" Stretch="Uniform" Stroke="#FF111418" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Hero image -->
                    <Grid Margin="0,24,0,0" Height="420">
                        <Border CornerRadius="16" BoxShadow="0 12 32 0 #3D000000">
                            <Border.Background><ImageBrush Source="/Assets/Images/hero.jpg" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                        <Border CornerRadius="16">
                            <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#00000000" Offset="0.45"/><GradientStop Color="#D9000000" Offset="1"/></LinearGradientBrush></Border.Background>
                        </Border>
                        <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,22">
                            <Border HorizontalAlignment="Left" Background="#FFE63946" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="EXCLUSIVE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="Ut enim ad minim veniam, quis nostrud exercitation ullamco" FontSize="24" FontWeight="Bold" LineHeight="30" Foreground="White" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Path Data="M23,19 A2,2 0 0 1 21,21 L3,21 A2,2 0 0 1 1,19 L1,8 A2,2 0 0 1 3,6 L7,6 L9,3 L15,3 L17,6 L21,6 A2,2 0 0 1 23,8 Z M16,13 A4,4 0 1 1 8,13 A4,4 0 1 1 16,13 Z" Width="14" Height="14" Stretch="Uniform" Stroke="#CCFFFFFF" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"/>
                                <TextBlock Text="Photo: Lorem Picsum" FontSize="12" Foreground="#CCFFFFFF" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="2,10,2,28">
                        <Path Data="M23,19 A2,2 0 0 1 21,21 L3,21 A2,2 0 0 1 1,19 L1,8 A2,2 0 0 1 3,6 L7,6 L9,3 L15,3 L17,6 L21,6 A2,2 0 0 1 23,8 Z M16,13 A4,4 0 1 1 8,13 A4,4 0 1 1 16,13 Z" Width="14" Height="14" Stretch="Uniform" Stroke="#FF6B7280" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Top" Margin="0,2,8,0"/>
                        <TextBlock Text="Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam." FontSize="13" FontStyle="Italic" Foreground="#FF6B7280" TextWrapping="Wrap" MaxWidth="700"/>
                    </StackPanel>
                    <!-- Key figures -->
                    <Grid Margin="0,4,0,32">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" CornerRadius="14" Padding="14,16" BoxShadow="0 6 18 0 #24000000">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#FFFDECEC" HorizontalAlignment="Left">
                                    <Path Data="M23,6 L13.5,15.5 L8.5,10.5 L1,18 M17,6 L23,6 L23,12" Width="20" Height="20" Stretch="Uniform" Stroke="#FFE63946" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="42%" FontSize="22" FontWeight="Black" Foreground="#FF111418" Margin="0,12,0,0"/>
                                <TextBlock Text="Lorem ipsum dolor sit amet" FontSize="12" Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="14,16" BoxShadow="0 6 18 0 #24000000">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#FFE8F2F7" HorizontalAlignment="Left">
                                    <Path Data="M22,12 A10,10 0 1 1 2,12 A10,10 0 1 1 22,12 Z M2,12 L22,12 M12,2 A15.3,15.3 0 0 1 16,12 A15.3,15.3 0 0 1 12,22 A15.3,15.3 0 0 1 8,12 A15.3,15.3 0 0 1 12,2 Z" Width="20" Height="20" Stretch="Uniform" Stroke="#FF457B9D" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="1.2k" FontSize="22" FontWeight="Black" Foreground="#FF111418" Margin="0,12,0,0"/>
                                <TextBlock Text="Consectetur adipiscing elit" FontSize="12" Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Background="White" CornerRadius="14" Padding="14,16" BoxShadow="0 6 18 0 #24000000">
                            <StackPanel>
                                <Border Width="40" Height="40" CornerRadius="20" Background="#FFE8F5F3" HorizontalAlignment="Left">
                                    <Path Data="M17,21 L17,19 A4,4 0 0 0 13,15 L5,15 A4,4 0 0 0 1,19 L1,21 M13,7 A4,4 0 1 1 5,7 A4,4 0 1 1 13,7 Z M23,21 L23,19 A4,4 0 0 0 20,15.13 M16,3.13 A4,4 0 0 1 16,10.88" Width="20" Height="20" Stretch="Uniform" Stroke="#FF2A9D8F" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="9.6k" FontSize="22" FontWeight="Black" Foreground="#FF111418" Margin="0,12,0,0"/>
                                <TextBlock Text="Sed do eiusmod tempor" FontSize="12" Foreground="#FF6B7280" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- Article body -->
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="L" FontSize="76" FontWeight="Black" Foreground="#FFE63946" Margin="0,-10,12,0" VerticalAlignment="Top"/>
                        <TextBlock FontSize="17" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#FF2B2F36" Grid.Column="1">orem ipsum dolor sit amet, <Bold>consectetur adipiscing elit</Bold>. Donec in suscipit magna. Maecenas vel quam ut quam bibendum posuere et ac tellus. Cras sagittis neque interdum sapien pellentesque, <Italic>eget venenatis est luctus</Italic>. Sed augue erat, lobortis id lobortis ac, rutrum vel ex. Sed non nisl facilisis, mollis est ut, ornare ex.</TextBlock>
                    </Grid>
                    <TextBlock FontSize="17" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#FF2B2F36" >Nam finibus, est sed tincidunt faucibus, lectus dui congue urna, vel bibendum sem mauris vel eros. Aenean placerat eleifend nibh a commodo. <Underline><Run Foreground="#FFE63946">Fusce nec mattis orci</Run></Underline>. Nam ac pharetra lacus. Suspendisse a nunc vitae elit ullamcorper efficitur. <Bold>Duis mattis magna velit.</Bold> Nullam quis turpis quis lacus fermentum tristique eu sed ex. Maecenas tincidunt ligula in lorem viverra, <Italic>sit amet fringilla magna ornare</Italic>.</TextBlock>
                    <TextBlock FontSize="17" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#FF2B2F36" >Nam pulvinar, mi eu congue rhoncus, lectus magna mollis lectus, eu commodo ipsum diam id neque. Sed malesuada eros sit amet lobortis dictum. Maecenas tincidunt finibus enim, quis laoreet felis tempor non. Mauris sit amet urna diam. Pellentesque habitant morbi tristique senectus et netus et malesuada fames ac turpis egestas. Donec euismod leo ac euismod bibendum. Vivamus a molestie sapien. Pellentesque non mollis metus. Proin et felis vel turpis cursus congue sed quis velit.</TextBlock>
                    <StackPanel Margin="0,20,0,16">
                        <Border Width="44" Height="4" CornerRadius="2" HorizontalAlignment="Left">
                            <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#FFE63946" Offset="0"/><GradientStop Color="#FFF4A261" Offset="1"/></LinearGradientBrush></Border.Background>
                        </Border>
                        <TextBlock Text="Quis nostrud exercitation ullamco" FontSize="27" FontWeight="Bold" LineHeight="34" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#FF111418"/>
                    </StackPanel>
                    <TextBlock FontSize="17" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#FF2B2F36" >Quisque pulvinar sagittis ex, nec hendrerit justo aliquam a. Maecenas malesuada ipsum vel ex molestie, id faucibus quam blandit. Nullam iaculis maximus ligula ac tempus. Phasellus ut magna eget nulla faucibus congue vel sed mauris. Donec euismod mauris in elit porttitor, ut iaculis nisl mollis. Donec ullamcorper, est eget tincidunt iaculis, urna eros suscipit tortor, ut luctus est nunc et dui. Phasellus mollis urna ac ante molestie dictum. Pellentesque viverra venenatis dictum. Aliquam eu lectus eget libero faucibus ornare vitae quis elit.</TextBlock>
                    <TextBlock FontSize="17" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#FF2B2F36" >Ut vitae imperdiet mi. Cras dictum elit vel condimentum accumsan. Vivamus id neque eget arcu bibendum posuere id nec lorem. Morbi eros orci, congue non lacinia id, euismod non lorem. In sit amet felis malesuada diam lobortis tempor et tempus diam. Aenean ut metus turpis. Interdum et malesuada fames ac ante ipsum primis in faucibus. Mauris suscipit orci auctor purus bibendum rhoncus. Mauris in placerat leo, sit amet molestie ligula.</TextBlock>
                    <Image Source="/Assets/Images/waterfall.jpg" Stretch="UniformToFill" Height="320" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="2,10,2,28">
                        <Path Data="M23,19 A2,2 0 0 1 21,21 L3,21 A2,2 0 0 1 1,19 L1,8 A2,2 0 0 1 3,6 L7,6 L9,3 L15,3 L17,6 L21,6 A2,2 0 0 1 23,8 Z M16,13 A4,4 0 1 1 8,13 A4,4 0 1 1 16,13 Z" Width="14" Height="14" Stretch="Uniform" Stroke="#FF6B7280" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Top" Margin="0,2,8,0"/>
                        <TextBlock Text="Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum." FontSize="13" FontStyle="Italic" Foreground="#FF6B7280" TextWrapping="Wrap" MaxWidth="700"/>
                    </StackPanel>
                    <TextBlock FontSize="17" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#FF2B2F36" >Nunc blandit vel sapien et placerat. Donec in tortor nec sem lobortis elementum. Suspendisse congue gravida molestie. Quisque sit amet semper quam, vitae varius felis. Aliquam in ipsum tempus, mollis nibh vitae, sodales mauris. Vivamus at egestas nisi, a consectetur elit. Nullam id ligula faucibus, ullamcorper eros vitae, vestibulum ante. Morbi rutrum augue sit amet massa varius, non congue lectus condimentum. Aenean elit metus, ultrices accumsan laoreet eu, tempor quis orci. Phasellus consectetur eget massa et volutpat. In accumsan ante et molestie egestas. Morbi ut justo iaculis, efficitur dolor viverra, suscipit lacus. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos.</TextBlock>
                    <!-- Pull quote -->
                    <Grid Margin="0,14,0,34">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Rectangle RadiusX="2" RadiusY="2">
                            <Rectangle.Fill><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#FFE63946" Offset="0"/><GradientStop Color="#FFF4A261" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Grid.Column="1" Margin="22,4,0,4">
                            <Path Data="M0,20 L0,12 C0,5 4,1 10,0 L11,3 C7,4.5 5.5,7 5.5,10 L10,10 L10,20 Z M14,20 L14,12 C14,5 18,1 24,0 L25,3 C21,4.5 19.5,7 19.5,10 L24,10 L24,20 Z" Fill="#FFE63946" Opacity="0.3" Width="44" Height="36" Stretch="Uniform" HorizontalAlignment="Left"/>
                            <TextBlock Text="“Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet, consectetur, adipisci velit.”" FontSize="25" FontStyle="Italic" LineHeight="36" Foreground="#FF1D3557" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="— Marcus Tullius Lorem, Ipsum Institute" FontSize="14" FontWeight="SemiBold" Foreground="#FF6B7280" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock FontSize="17" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#FF2B2F36" >Fusce in lacus quis ipsum scelerisque fringilla eget eget neque. Etiam dictum, ipsum et rutrum luctus, mauris massa mattis tortor, nec mollis ligula odio et metus. Vestibulum eget dignissim orci. Etiam fermentum urna leo, in posuere nibh bibendum at. Suspendisse potenti. Suspendisse lobortis sapien in leo fermentum aliquam. Orci varius natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus.</TextBlock>
                    <TextBlock FontSize="17" LineHeight="28" TextWrapping="Wrap" Margin="0,0,0,20" Foreground="#FF2B2F36" >Aenean augue enim, hendrerit non lorem nec, blandit luctus nunc. Nulla pretium erat at nulla feugiat tristique. Nam auctor et augue vitae auctor. Nam sodales cursus justo sit amet viverra. Fusce condimentum, ligula et maximus dapibus, tellus diam tempor orci, at viverra mauris elit nec dui. Praesent sodales nulla sed ipsum feugiat, eget finibus velit pretium. Interdum et malesuada fames ac ante ipsum primis in faucibus. Maecenas consequat sagittis libero eu sollicitudin. Quisque sem tortor, consectetur at ullamcorper in, egestas et orci. Quisque ut velit vitae nisl eleifend porta finibus in elit. Mauris eros eros, sollicitudin quis finibus et, ultricies id neque.</TextBlock>
                    <!-- Chart -->
                    <Border Background="White" CornerRadius="16" Padding="22" Margin="0,10,0,32" BoxShadow="0 6 18 0 #24000000">
                        <StackPanel>
                            <Grid>
