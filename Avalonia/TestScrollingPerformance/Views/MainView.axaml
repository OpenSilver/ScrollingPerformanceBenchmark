                                    <Path Data="M20,6 L9,17 L4,12" Width="13" Height="13" Stretch="Uniform" Stroke="White" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Maecenas eget augue euismod, convallis lacus in, condimentum ante." FontSize="15" LineHeight="23" Foreground="#FF2B2F36" TextWrapping="Wrap" Margin="12,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" CornerRadius="12" Background="#FF2A9D8F" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Path Data="M20,6 L9,17 L4,12" Width="13" Height="13" Stretch="Uniform" Stroke="White" StrokeThickness="1.75" StrokeLineCap="Round" StrokeJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
