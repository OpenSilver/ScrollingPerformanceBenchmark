                                <TextBlock Grid.Column="1" Text="Sed rhoncus fermentum tellus, quis fringilla augue convallis at." FontSize="15" LineHeight="23" Foreground="#FF2B2F36" TextWrapping="Wrap" Margin="12,0,0,0"/>
