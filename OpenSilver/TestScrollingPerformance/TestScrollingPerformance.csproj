<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <EnableDefaultItems>true</EnableDefaultItems>
    <DefineSilverlight>true</DefineSilverlight>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="3.4.0-preview-2026-11-17-153412-526ff1ab" />
    <PackageReference Include="OpenSilver.Animations" Version="3.4.0-preview-2026-11-03-231912-b711092b" />
    <PackageReference Include="OpenSilver.Themes.Modern" Version="3.4.0-preview-2026-07-20-092918-c8997484" />
    <PackageReference Include="OpenSilver.WpfCompat" Version="3.4.0-preview-2026-11-03-082524-2911a35" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="**/*.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Page Remove="App.xaml" />
    <ApplicationDefinition Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\**" />
    <Resource Include="Assets\**" />
  </ItemGroup>

</Project>
