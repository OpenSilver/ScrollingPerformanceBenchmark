<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0-browserwasm;net11.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>TestScrollingPerformance</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.testscrollingperformance</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>TestScrollingPerformance</ApplicationPublisher>
    <!-- Package Description -->
    <Description>TestScrollingPerformance powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Skia;
    </UnoFeatures>
  </PropertyGroup>
  <ItemGroup>
    <None Update="Settings.job">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
